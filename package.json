{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/pack-source.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pack:source": "node scripts/pack-source.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx ./src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:reconcile": "node --env-file=.env --import tsx ./src/db/reconcile-migrations.ts",
    "db:seed": "node --env-file=.env --import tsx ./src/db/seed.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
